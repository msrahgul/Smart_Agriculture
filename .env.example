## Smart-Agriculture environment variables (example)
##
## Copy this file to `.env` and fill in values.
## Do NOT commit your real `.env` (it's already ignored by `.gitignore`).

# Gemini API key from Google AI Studio (https://aistudio.google.com/)
# IMPORTANT: paste the key value only (no quotes, no extra symbols).
# Example:
# GEMINI_API_KEY=AIzaSy...
GEMINI_API_KEY=

# Enables Gemini-based query parsing (intent/entity extraction) used for better query understanding.
AI_PARSER_ENABLED=true

# Model used for query parsing.
GEMINI_PARSER_MODEL=gemini-2.5-flash

# Gemini parser request timeout in seconds.
AI_PARSER_TIMEOUT=4

# Optional: set to true to print parser errors to the server console.
AI_PARSER_DEBUG=false

